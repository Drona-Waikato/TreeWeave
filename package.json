{
  "name": "treeweave",
  "version": "1.3.4",
  "description": "Visual project management — web server or standalone Mac app.",
  "main": "electron/main.js",
  "author": "TreeWeave",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder --mac",
    "dist:dir": "electron-builder --mac dir"
  },
  "build": {
    "appId": "com.treeweave.app",
    "productName": "TreeWeave",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
